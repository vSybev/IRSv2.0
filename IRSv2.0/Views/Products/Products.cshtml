@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link href="~/css/Orders.css" rel="stylesheet" />
}

<div class="container">
    <div class="table-container">
        <div class="table-header">
            <h2>Products</h2>
            <button class="add-btn"
                    data-bs-toggle="modal" 
                    data-bs-target="#addProductModal">
                <i class="bi bi-plus"></i>
            </button>
        </div>
        <table class="styled-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Type</th>
                    <th>Price</th>
                    <th>Availability</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Products.Count; i++)
                {
                    <tr>
                        <td>@(i + 1)</td>
                        <td>@Model.Products[i].ID</td>
                        <td>@Model.Products[i].Name</td>
                        <td>@Model.Products[i].Description</td>
                        <td>@Model.Products[i].Type</td>
                        <td>@Model.Products[i].Price</td>
                        <td>@Model.Products[i].Availability</td>
                    </tr>
                }>
            </tbody>
        </table>
    </div>
</div>


<!-- Modal -->
<div class="modal fade" id="addProductModal" tabindex="-1" aria-labelledby="addProductModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" 
                    id="addProductModalLabel">
                  Add New Product
                </h5>
                <button type="button" 
                        class="btn-close" 
                        data-bs-dismiss="modal" 
                        aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Форма, която изпраща POST заявка към контролера -->
                <form method="post" action="/Products/AddProduct">
                    <div class="mb-3">
                        <label for="productId" 
                               class="form-label">
                            ID
                        </label>
                        <input type="text" 
                                class="form-control" 
                                id="productId" 
                                name="ID" 
                                placeholder="Enter..." 
                                required>
                    </div>
                    <div class="mb-3">
                        <label for="productName" 
                               class="form-label">
                            Name
                        </label>
                        <input type="text" 
                                class="form-control" 
                                id="productName" 
                                name="Name" 
                                placeholder="Enter..." 
                                required>
                    </div>
                    <div class="mb-3">
                        <label for="productCount" 
                               class="form-label">
                            Count
                        </label>
                        <input type="number" 
                               class="form-control" 
                               id="productCount" 
                               name="Count" 
                               placeholder="Enter..." 
                               required>
                    </div>
                    <div class="mb-3">
                        <label for="productType" 
                               class="form-label">
                             Type
                        </label>
                        <select class="form-select" id="productType" name="Type">
                            <option value="Food">Food</option>
                            <option value="Drink">Drink</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="productStatus" 
                               class="form-label">
                             Status
                        </label>
                        <select class="form-select" id="productStatus" name="Status">
                            <option value="Not done">Not done</option>
                            <option value="Done">Done</option>
                        </select>
                    </div>
                    <div class="modal-footer">
                        <button type="button" 
                                class="btn btn-secondary" 
                                data-bs-dismiss="modal">
                             Close
                        </button>
                        <button type="submit" 
                                class="btn btn-primary" 
                                data-bs-dismiss="modal">
                             Add Product
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>