@model IRSv2._0.Models.RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
    <link href="~/css/Register.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.13/dist/jquery.validate.unobtrusive.min.js"></script>
}

<div class="container-body">
    <div class="register-container">
        <h1>Register</h1>
        <form asp-action="Register" method="post" novalidate>
            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" 
                       id="Name" 
                       class="form-control" 
                       placeholder="Enter name"/>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Position"></label>
                <input asp-for="Position" 
                       id="Position" 
                       class="form-control" 
                       placeholder="Enter position"/>
                <span asp-validation-for="Position" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Id"></label>
                <input asp-for="Id" 
                       id="Id" 
                       class="form-control" 
                       placeholder="Enter ID" />
                <span asp-validation-for="Id" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PhoneNumber"></label>
                <input asp-for="PhoneNumber" 
                       id="PhoneNumber" 
                       class="form-control" 
                       placeholder="Enter phone number" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <button type="submit" 
                        id="submitButton" 
                        class="btn btn-primary" 
                        disabled>
                    Submit</button>
            </div>
        </form>
        @if (ViewBag.Message != null)
        {
            <div class="alert alert-success">
                @ViewBag.Message
            </div>
        }
    </div>
</div>

<script>
    $(document).ready(function () {
        function validateForm() {
            const name = $("#Name").val();
            const position = $("#Position").val();
            const id = $("#Id").val();
            const phoneNumber = $("#PhoneNumber").val();

            const nameValid = /^[^\d]+$/.test(name);
            const idValid = /^[A-Za-z]{1}[0-9]+$/.test(id);
            const phoneValid = /^\+?[1-9]\d{1,14}$/.test(phoneNumber);

            if (nameValid && idValid && phoneValid && position) {
                $("#submitButton").prop("disabled", false);
            } else {
                $("#submitButton").prop("disabled", true);
            }
        }

        $("input").on("input", function () {
            validateForm();
        });

        validateForm();
    });
</script>