@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <link href="~/css/Orders.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
}

<div class="container">
    <div class="table-container">
        <div class="table-header">
            <h2>Orders</h2>
            <button class="add-btn" 
                    data-bs-toggle="modal" 
                    data-bs-target="#addOrderModal">
                <i class="bi bi-plus"></i>
            </button>
        </div>
        <table class="styled-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Count</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (OrdersModel order in Model.Orders)
                {
                    <tr>
                        <td>@order.ID</td>
                        <td>@order.Price</td>
                        <td>@order.WaiterID</td>
                        <td>@order.TableID</td>
                        @* <td> *@
                        @*     @foreach (OrdersModel product in @order.Products) *@
                        @*     { *@
                        @*         <div>@product</div> *@
                        @*     } *@
                        @* </td> *@
                        @* <td> *@
                        @*     @foreach (OrdersModel cook in @order.Cooks) *@
                        @*     { *@
                        @*         <div>@cook</div> *@
                        @*     } *@
                        @* </td> *@
                        @* ID = id; *@
                        @* Price = price; *@
                        @* WaiterID = waiterID; *@
                        @* TableID = tableID; *@
                        @* Products = new List *@
                        @* Cooks = new List<CooksModel>(); *@
                    </tr>
                }
                <tr>
                    <td>2</td>
                    <td>4321</td>
                    <td>Мусака</td>
                    <td>1</td>
                    <td>Drink</td>
                    <td>Not done</td>
                    <td><button class="action-btn">Edit</button></td>
                </tr>
                <tr>
                    <td>3</td>
                    <td>7557</td>
                    <td>Таратор</td>
                    <td>2</td>
                    <td>Food</td>
                    <td>Not done</td>
                    <td><button class="action-btn">Edit</button></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>


<!-- Modal -->
<div class="modal fade" id="addOrderModal" tabindex="-1" aria-labelledby="addOrderModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" 
                    id="addOrderModalLabel">
                  Add New Order</h5>
                <button type="button" 
                        class="btn-close" 
                        data-bs-dismiss="modal" 
                        aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Форма, която изпраща POST заявка към контролера -->
                <form method="post" action="/Orders/AddOrder">
                    <div class="mb-3">
                        <label for="orderId" class="form-label">ID</label>
                        <input type="text" 
                               class="form-control" 
                               id="orderId" 
                               name="ID" 
                               placeholder="Enter..." 
                               required>
                    </div>
                    <div class="mb-3">
                        <label for="orderName" class="form-label">Name</label>
                        <input type="text" 
                               class="form-control" 
                               id="orderName" 
                               name="Name" 
                               placeholder="Enter..." 
                               required>
                    </div>
                    <div class="mb-3">
                        <label for="orderCount" class="form-label">Count</label>
                        <input type="number" 
                               class="form-control" 
                               id="orderCount" 
                               name="Count" 
                               placeholder="Enter..." 
                               required>
                    </div>
                    <div class="mb-3">
                        <label for="orderType" class="form-label">Type</label>
                        <select class="form-select" id="orderType" name="Type">
                            <option value="Food">Food</option>
                            <option value="Drink">Drink</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="orderStatus" class="form-label">Status</label>
                        <select class="form-select" id="orderStatus" name="Status">
                            <option value="Not done">Not done</option>
                            <option value="Done">Done</option>
                        </select>
                    </div>
                    <div class="modal-footer">
                        <button type="button" 
                                class="btn btn-secondary" 
                                data-bs-dismiss="modal">
                             Close</button>
                        <button type="submit" 
                                class="btn btn-primary" 
                                data-bs-dismiss="modal">
                             Add Order</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
