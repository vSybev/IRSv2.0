@model IRSv2._0.Models.LoginModel

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
    <link href="~/css/Login.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.13/dist/jquery.validate.unobtrusive.min.js"></script>
}

<div class="container-body">
    <div class="login-container">
        <h1>Login</h1>
        <form asp-controller="Login" asp-action="Login" method="post" novalidate>
            <div class="form-group">
                <label asp-for="Id"></label>
                <input asp-for="Id" class="form-control" placeholder="Enter your ID" />
                <span asp-validation-for="Id" class="text-danger"></span>
            </div>
            <div class="form-group">
                <button type="submit" 
                        name="submitForm" 
                        class="btn btn-primary" 
                        value="Login">Submit
                </button>
            </div>
        </form>
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger">
                @ViewBag.ErrorMessage
            </div>
        }
    </div>
</div>