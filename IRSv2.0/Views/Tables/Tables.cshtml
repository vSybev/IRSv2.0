@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link href="~/css/Tables.css" rel="stylesheet"/>
   
}

<div class="container">
    <div class="position-container">
        <div class="circle-btn" data-bs-toggle="modal" data-bs-target="#modal1"> 1</div>
        <div class="circle-btn" data-bs-toggle="modal" data-bs-target="#modal1">2</div>
        <div class="circle-btn" data-bs-toggle="modal" data-bs-target="#modal1">3</div>
        <div class="circle-btn" data-bs-toggle="modal" data-bs-target="#modal1">4</div>
        <div class="circle-btn" data-bs-toggle="modal" data-bs-target="#modal1">5</div>
        <div class="label-box">A</div>
    </div>
</div>


    

<!-- Modal -->
<div class="modal fade" id="modal1" style="z-index: 1054"  tabindex="-1" aria-labelledby="modal1Label" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog mdd">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"
                    id="modal1Label">
                    Add New Order
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @Html.Partial("_OrdersPartial")
            </div>
        </div>
    </div>
</div>